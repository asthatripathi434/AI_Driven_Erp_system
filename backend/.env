# Database
DATABASE_URL=your-mongodb-url-here
DB_NAME=your-db-name-here

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# School Info
SCHOOL_NAME=Your School Name
SCHOOL_PLACE=Your School Place

# Razorpay (Test Keys)
RAZORPAY_KEY_ID=your-razorpay-key-id-here
RAZORPAY_SECRET=your-razorpay-secret-here
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret-here
VERIFY_SIGNATURE=True

# SMTP (Email)
SMTP_USER=your-email-here
SMTP_PASS=your-email-password-here
SMTP_FROM=your-email-here

# Excel Path
EXCEL_PATH=path-to-your-excel-file

# Bank Details
ACCOUNT_NAME=Your Account Name
ACCOUNT_NUMBER=your-account-number-here
IFSC=your-ifsc-code-here
BANK_NAME=Your Bank Name
UPI_ID=your-upi-id-here
